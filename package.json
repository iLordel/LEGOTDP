{
  "name": "ltdp",
  "version": "1.8.0",
  "description": "DeckyLoader plugin for TDP limits on the original Lenovo Legion Go, through Lenovo WMI, acpi_call or ryzenadj",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package.mjs",
    "test": "python -m unittest discover -s tests -t tests"
  },
  "devDependencies": {
    "@decky/api": "^1.1.3",
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.12.0",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "rollup": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iLordel/LEGOTDP.git"
  },
  "homepage": "https://github.com/iLordel/LEGOTDP",
  "bugs": {
    "url": "https://github.com/iLordel/LEGOTDP/issues"
  }
}
